{
  "manifest_version": 3,
  "name": "DeepSeek Orbit - Smart Workspace & RTL Flow",
  "version": "1.5.0",
  "description": "Smart Persian/Arabic RTL alignment, Developer Code Tools (Line numbers, Word wrap, Fullscreen viewer), In-Chat Keyword Search, Bookmark Pins, Slash Commands, Custom Wallpapers, and Chat Exporter for DeepSeek.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DeepSeek Orbit Settings"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*"
      ],
      "js": [
        "src/core/constants.js",
        "src/core/detector.js",
        "src/core/storage.js",
        "src/ui/code-enhancer.js",
        "src/ui/search.js",
        "src/ui/pins.js",
        "src/ui/wallpaper.js",
        "src/ui/slash-commands.js",
        "src/ui/toolbar.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
